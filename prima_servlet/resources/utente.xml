<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace = nome completo dell'interfaccia (con il package .mapper) -->
<mapper namespace="it.exolab.mapper.UtenteMapper">

  <!-- colonna nel db: pass  |  campo nel model: pssw -->
  <insert id="insert" parameterType="it.exolab.model.UtenteModel"
    useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    insert into utenti (nome, cognome, eta, email, pass, username)
    values (#{nome}, #{cognome}, #{eta}, #{email}, #{pssw}, #{username})
  </insert>

  <!-- Per ora non serve - <update id="update" parameterType="it.exolab.model.UtenteModel">
    update utenti set nome = #{nome}, cognome = #{cognome}, eta = #{eta} where id = #{id}
  </update>-->

  <select id="find" parameterType="String" resultType="it.exolab.model.UtenteModel">
    select id, nome, cognome, eta, email, pass AS pssw, username
    from utenti where username = #{username}
  </select>

  <select id="countByEmail" parameterType="String" resultType="int">
    SELECT COUNT(*) FROM utenti WHERE email = #{email}
  </select>

  <select id="countByUsername" parameterType="String" resultType="int">
    SELECT COUNT(*) FROM utenti WHERE username = #{username}
  </select>
</mapper>
