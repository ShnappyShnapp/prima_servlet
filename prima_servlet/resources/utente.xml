<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="it.exolab.UtenteMapper">
   <insert id="insert" parameterType="it.exolab.UtenteModel" 
  	useGeneratedKeys="true"
    keyProperty="id"
  	keyColumn="id"
  >
    insert into utenti (nome,cognome,eta,email,pssw,username) values (#{nome},#{cognome},#{eta},#{email},#{password},#{username})
  </insert>
  
  <!-- Per ora non serve - <update id="update" parameterType="it.exolab.UtenteModel">
    update  utenti set  nome =  #{nome} ,cognome = #{cognome} ,eta = #{eta}, citta = #{citta}, indirizzo = #{indirizzo} where id = #{id}
  </update>-->
  
  <!-- per ora non serve - <delete id="delete" parameterType="String, String">
    delete from  utenti where email = #{email} and pssw = #{password}
  </delete>-->
  
  <select id="find" resultType="it.exolab.UtenteModel" 
  	parameterType="int" 
  >
    select * from utenti where email = #{email} and pssw = #{password}
  </select>
</mapper>